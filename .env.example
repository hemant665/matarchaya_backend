# Copy to `.env` and adjust. `.env` is git-ignored; never commit real secrets.

# --- Server ---------------------------------------------------------------
ADDRESS=127.0.0.1
PORT=8080
RUST_LOG=info

# --- Database (PostgreSQL 13+) ---------------------------------------------
# Pending migrations in ./migrations are applied automatically on startup.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/matarchiya
DATABASE_MAX_CONNECTIONS=10

# --- CORS ------------------------------------------------------------------
# Comma-separated frontend origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Auth ------------------------------------------------------------------
# Signs access tokens. At least 32 characters; generate with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_TOKEN_EXP_MINUTES=15
REFRESH_TOKEN_EXP_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=refresh_token
# Must match where the /auth routes are mounted; browsers only send the
# refresh cookie to this path.
REFRESH_COOKIE_PATH=/auth
# true  (default): Secure + SameSite=None. Required in production (HTTPS).
# false: plain-http local development only (SameSite=Lax).
REFRESH_COOKIE_SECURE=false

# --- First admin account ---------------------------------------------------
# Optional. Created on startup if no user has this email; an existing account
# is never modified. Without it a fresh database has no one who can sign in.
# Set both or neither. The password needs at least 8 characters.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Admin
